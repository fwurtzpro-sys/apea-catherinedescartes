# Copy to .env.local for development. Never commit real values.

# Resend API key used to send the volunteer sign-up form (see
# src/app/api/inscriptions/route.ts). Create one at https://resend.com.
RESEND_API_KEY=

# Mailbox that receives the volunteer sign-up notifications.
INSCRIPTIONS_RECIPIENT_EMAIL=apeaelven@gmail.com

# Sender address used by Resend. Must belong to a domain verified in your
# Resend account (Resend rejects unverified senders) — see the report for
# exactly what to put here once the APEA's domain is verified.
RESEND_FROM_EMAIL=
